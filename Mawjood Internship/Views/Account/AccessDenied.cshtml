@using BLogicLayer.ViewModels

@{
    ViewData["Title"] = "Access Denied";
}

<section class="mw-section">
    <div class="mw-container">
        <div class="mw-card mw-card-pad" style="max-width: 620px; margin-inline: auto; text-align: center;">
            <div class="mw-auth-icon" style="margin-bottom: 16px;">
                <span class="material-symbols-outlined">
                    lock
                </span>
            </div>

            <h1 class="text-danger" style="font-weight: 700; margin-bottom: 10px;">
                Access Denied
            </h1>

            <p class="mw-muted" style="margin-bottom: 24px; font-size: 16px;">
                You don't have permission to access this page.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="mw-btn mw-btn-primary">
                Back to Home
            </a>
        </div>
    </div>
</section>