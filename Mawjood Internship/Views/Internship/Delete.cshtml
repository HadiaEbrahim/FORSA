@model BLogicLayer.ViewModels.InternshipViewModel

@{
    ViewData["Title"] = "Delete Internship";
}

<section class="mw-section">
    <div class="container mw-container">

        <div class="mw-card mw-card-pad mx-auto"
             style="max-width: 650px;">

            <div class="text-center mb-4">

                <div class="mw-auth-icon mb-3">
                    <span class="material-symbols-outlined">
                        delete
                    </span>
                </div>

                <span class="mw-eyebrow">CONFIRM DELETION</span>

                <h1 class="fw-bold mb-1" style="color: var(--forsa-text);">
                    Delete Internship
                </h1>

                <p class="mw-muted mb-0">
                    Are you sure you want to delete this internship?
                </p>

            </div>


            <div class="mw-info-grid mb-4">

                <div class="mw-info-item">

                    <div class="mw-info-label">
                        Internship Title
                    </div>

                    <div class="mw-info-value">
                        @Model.Title
                    </div>

                </div>


                <div class="mw-info-item">

                    <div class="mw-info-label">
                        Location
                    </div>

                    <div class="mw-info-value">
                        @Model.Location
                    </div>

                </div>


                <div class="mw-info-item" style="grid-column: 1 / -1;">

                    <div class="mw-info-label">
                        Company
                    </div>

                    <div class="mw-info-value">
                        @Model.CompanyName
                    </div>

                </div>

            </div>


            <div class="mw-alert mw-alert-error mb-4"
                 style="width: 100%; margin-top: 0;">
                <strong>Warning:</strong>
                This action cannot be undone.
            </div>


            <form asp-controller="Internship"
                  asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <div class="d-flex gap-2 justify-content-end flex-wrap mt-4">

                    <a asp-controller="Internship"
                       asp-action="Index"
                       class="mw-btn mw-btn-outline">

                        Cancel

                    </a>


                    <button type="submit"
                            class="mw-btn mw-btn-primary"
                            style="background: var(--forsa-burgundy-dark);">

                        <span class="material-symbols-outlined" style="font-size: 18px;">
                            delete
                        </span>

                        Delete Internship

                    </button>

                </div>

            </form>

        </div>

    </div>
</section>