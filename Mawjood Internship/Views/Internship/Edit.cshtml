@model BLogicLayer.ViewModels.InternshipViewModel

@{
    ViewData["Title"] = "Edit Internship";
}

<section class="mw-section">
    <div class="container mw-container">

        <div class="mw-card mw-form">

            <div class="mb-4">
                <span class="mw-eyebrow">INTERNSHIP MANAGEMENT</span>

                <h1 class="mb-2 fw-bold" style="color: var(--forsa-text);">
                    Edit Internship
                </h1>

                <p class="mw-muted mb-0">
                    Update internship information.
                </p>
            </div>

            <form asp-controller="Internship"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <div asp-validation-summary="All"
                     class="mw-alert mw-alert-error mb-3"
                     style="width: 100%; margin-top: 0;"
                     role="alert">
                </div>

                <div class="row g-3">

                    <!-- Title -->
                    <div class="col-12">

                        <label asp-for="Title"
                               class="form-label fw-semibold">
                            Internship Title
                        </label>

                        <input asp-for="Title"
                               class="form-control mw-input" />

                        <span asp-validation-for="Title"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- Location -->
                    <div class="col-md-6">

                        <label asp-for="Location"
                               class="form-label fw-semibold">
                            Location
                        </label>

                        <input asp-for="Location"
                               class="form-control mw-input" />

                        <span asp-validation-for="Location"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- Company ID -->
                    <div class="col-md-6">

                        <label asp-for="CompanyId"
                               class="form-label fw-semibold">
                            Company ID
                        </label>

                        <input asp-for="CompanyId"
                               type="number"
                               min="1"
                               class="form-control mw-input" />

                        <span asp-validation-for="CompanyId"
                              class="text-danger small">
                        </span>

                        <div class="form-text mw-muted">
                            Enter the ID of an existing company.
                        </div>

                    </div>

                </div>

                <div class="mw-actions-row mt-4">

                    <button type="submit"
                            class="mw-btn mw-btn-primary">

                        <span class="material-symbols-outlined" style="font-size: 18px;">
                            save
                        </span>

                        Save Changes

                    </button>

                    <a asp-controller="Internship"
                       asp-action="Index"
                       class="mw-btn mw-btn-outline">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}