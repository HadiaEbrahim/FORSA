@model BLogicLayer.ViewModels.InternshipViewModel

@{
    ViewData["Title"] = "Internship Details";
}

<div class="mw-container mw-section">

    <a class="mw-link d-inline-flex align-items-center gap-1" asp-action="Index">
        <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
        Back to internships
    </a>

    <div class="mw-card mw-detail mt-3">

        <span class="mw-chip">@Model.Location</span>

        <h1 class="mt-3">@Model.Title</h1>

        <p class="mw-muted mb-0">
            @Model.CompanyName
        </p>

        <div class="mw-detail-section mt-4">

            <h2>Internship Details</h2>

            <div class="mw-info-grid">

                <div class="mw-info-item">
                    <div class="mw-info-label">Title</div>
                    <div class="mw-info-value">
                        @Model.Title
                    </div>
                </div>

                <div class="mw-info-item">
                    <div class="mw-info-label">Location</div>
                    <div class="mw-info-value">
                        @Model.Location
                    </div>
                </div>

                <div class="mw-info-item" style="grid-column: 1 / -1;">
                    <div class="mw-info-label">Company</div>
                    <div class="mw-info-value">
                        @Model.CompanyName
                    </div>
                </div>

            </div>
        </div>

        @* =========================
           ADMIN ACTIONS
           ========================= *@

        @if (User.IsInRole("Admin"))
        {
            <div class="mw-actions-row">

                <a class="mw-btn mw-btn-primary"
                   asp-action="Edit"
                   asp-route-id="@Model.Id">
                    <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>
                    Edit Internship
                </a>

                <a class="mw-btn mw-btn-outline"
                   asp-action="Delete"
                   asp-route-id="@Model.Id">
                    <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                    Delete
                </a>

            </div>
        }

        @* =========================
           STUDENT ACTIONS
           ========================= *@

        else if (User.IsInRole("User"))
        {
            <div class="mw-detail-section">

                <div class="mw-card mw-card-pad"
                     style="background:var(--forsa-surface-soft);border-color:var(--forsa-border);">

                    <span class="mw-eyebrow">OPPORTUNITY APPLICATION</span>
                    <strong class="d-block fs-6" style="color:var(--forsa-text);">Interested in this opportunity?</strong>

                    <p class="mw-muted mb-3 mt-1">
                        Apply now and your profile will be matched automatically
                        with this internship.
                    </p>

                    @if (Model.HasApplied)
                    {
                        @if (Model.ApplicationStatus == "Accepted")
                        {
                            <span class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 fw-semibold"
                                  style="background-color: #dcfce7; color: #15803d; border: 1px solid #86efac;">
                                <span class="material-symbols-outlined" style="font-size: 18px;">
                                    check_circle
                                </span>
                                <span>Accepted</span>
                            </span>
                        }
                        else if (Model.ApplicationStatus == "Rejected")
                        {
                            <span class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 fw-semibold"
                                  style="background-color: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5;">
                                <span class="material-symbols-outlined" style="font-size: 18px;">
                                    cancel
                                </span>
                                <span>Rejected</span>
                            </span>
                        }
                        else
                        {
                            <button type="button"
                                    class="mw-btn mw-btn-outline"
                                    disabled>
                                <span class="material-symbols-outlined" style="font-size: 18px;">
                                    schedule
                                </span>
                                <span>
                                    Applied / Pending
                                </span>
                            </button>
                        }
                    }
                    else
                    {
                        <form asp-controller="Application"
                              asp-action="Apply"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="internshipId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="mw-btn mw-btn-primary">

                                <span class="material-symbols-outlined" style="font-size: 18px;">
                                    send
                                </span>

                                Apply Now

                            </button>

                        </form>
                    }

                </div>

            </div>
        }

        @* =========================
           NOT LOGGED IN
           ========================= *@

        else
        {
            <div class="mw-detail-section">

                <div class="mw-card mw-card-pad"
                     style="background:var(--forsa-surface-soft);border-color:var(--forsa-border);">

                    <span class="mw-eyebrow">GET STARTED</span>
                    <strong class="d-block fs-6" style="color:var(--forsa-text);">Interested in this opportunity?</strong>

                    <p class="mw-muted mb-3 mt-1">
                        Login as a student to apply for this internship.
                    </p>

                    <a class="mw-btn mw-btn-primary"
                       asp-controller="Account"
                       asp-action="Login">
                        Login to Apply
                    </a>

                </div>

            </div>
        }

    </div>
</div>