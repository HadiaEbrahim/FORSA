@model BLogicLayer.ViewModels.CompanyViewModel

@{
    ViewData["Title"] = "Delete Company";
}

<section class="mw-section">
    <div class="mw-container">
        <div class="row justify-content-center">
            <div class="col-lg-7">

                <div class="mw-card mw-form">

                    <div class="mb-4">
                        <span class="mw-eyebrow">COMPANY MANAGEMENT</span>
                        <h2 class="mb-1 fw-bold" style="color: var(--forsa-text);">
                            Delete Company
                        </h2>
                        <p class="mw-muted mb-0">
                            Review the company details before confirming deletion.
                        </p>
                    </div>

                    <div class="mw-alert mw-alert-error mb-4"
                         style="width: 100%; margin-top: 0;">
                        <div>
                            <strong>Are you sure you want to delete this company?</strong>
                            <div class="mt-1">This action cannot be undone.</div>
                        </div>
                    </div>

                    <div class="mw-card mw-card-pad mb-4">
                        <h4 class="mb-3 fw-bold" style="color: var(--forsa-text);">@Model.Name</h4>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="mw-info-item">
                                    <div class="mw-info-label">Email</div>
                                    <div class="mw-info-value">@Model.Email</div>
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="mw-info-item">
                                    <div class="mw-info-label">City</div>
                                    <div class="mw-info-value">@Model.City</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="DeleteConfirmed"
                          method="post"
                          class="mt-3">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit"
                                    class="mw-btn mw-btn-primary"
                                    style="background: var(--forsa-burgundy-dark);">
                                <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                                Yes, Delete
                            </button>

                            <a asp-action="Index"
                               class="mw-btn mw-btn-outline">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>
</section>