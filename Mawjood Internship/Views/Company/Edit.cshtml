@model BLogicLayer.ViewModels.CompanyViewModel

@{
    ViewData["Title"] = "Edit Company";
}

<section class="mw-section">
    <div class="mw-container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="mw-card mw-form">

                    <span class="mw-eyebrow">COMPANY MANAGEMENT</span>
                    <h2 class="mb-4 fw-bold" style="color: var(--forsa-text);">
                        Edit Company
                    </h2>

                    <form asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="mw-alert mw-alert-error mb-3"
                             style="width: 100%; margin-top: 0;">
                        </div>

                        <div class="row g-3">

                            <div class="col-12">
                                <label asp-for="Name"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Name"
                                       class="form-control mw-input" />

                                <span asp-validation-for="Name"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Email"
                                       class="form-control mw-input" />

                                <span asp-validation-for="Email"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description"
                                       class="form-label fw-semibold">
                                </label>

                                <textarea asp-for="Description"
                                          rows="3"
                                          class="form-control mw-input"></textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="City"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="City"
                                       class="form-control mw-input" />

                                <span asp-validation-for="City"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Government"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Government"
                                       class="form-control mw-input" />

                                <span asp-validation-for="Government"
                                      class="text-danger small">
                                </span>
                            </div>

                        </div>

                        <div class="d-flex gap-2 flex-wrap pt-4">
                            <button type="submit"
                                    class="mw-btn mw-btn-primary">
                                <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               class="mw-btn mw-btn-outline">
                                Back
                            </a>
                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}