@model BLogicLayer.ViewModels.CompanyViewModel

@{
    ViewData["Title"] = "Company Details";
}

<section class="mw-section">
    <div class="mw-container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="mw-card mw-card-pad">

                    <div class="pb-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2"
                         style="border-bottom: 1px solid var(--forsa-border);">
                        <div>
                            <span class="mw-eyebrow">COMPANY PROFILE</span>
                            <h2 class="mb-0 fw-bold" style="color: var(--forsa-text);">
                                Company Details
                            </h2>
                        </div>

                        <span class="mw-chip-green">@Model.City</span>
                    </div>

                    <h4 class="mb-4 fw-bold" style="color: var(--forsa-burgundy-dark);">
                        @Model.Name
                    </h4>

                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <div class="mw-info-item">
                                <div class="mw-info-label">Email</div>
                                <div class="mw-info-value">@Model.Email</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mw-info-item">
                                <div class="mw-info-label">Government</div>
                                <div class="mw-info-value">@Model.Government</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mw-info-item">
                                <div class="mw-info-label">City</div>
                                <div class="mw-info-value">@Model.City</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="mw-info-item">
                                <div class="mw-info-label">Description</div>
                                <div class="mw-info-value">@Model.Description</div>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex gap-2 flex-wrap pt-2">
                        <a asp-action="Index"
                           class="mw-btn mw-btn-outline">
                            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
                            Back
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="mw-btn mw-btn-primary">
                                <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>
                                Edit
                            </a>
                        }
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>