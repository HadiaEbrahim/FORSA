@model List<BLogicLayer.ViewModels.ApplicationViewModel>

@{
    ViewData["Title"] = "Applications";
}

<div class="mw-container mw-section">

    <div class="mw-section-head">

        <div>
            <div class="mw-chip">Admin</div>

            <h2 class="mt-2">
                Applications Review
            </h2>

            <p>
                Review student applications, matching scores and application status.
            </p>
        </div>

    </div>


    <div class="mw-card mw-table-wrap">

        @if (Model == null || !Model.Any())
        {
            <div class="mw-empty">

                <span class="material-symbols-outlined"
                      style="font-size:42px;">
                    inbox
                </span>

                <h3 class="mt-3">
                    No applications found
                </h3>

                <p>
                    There are currently no student applications.
                </p>

            </div>
        }
        else
        {
            <table class="mw-table">

                <thead>
                    <tr>
                        <th>Applicant</th>
                        <th>Internship</th>
                        <th>Matching</th>
                        <th>CV</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var application in Model)
                    {
                        var cvValue = application.CVLink?.Trim() ?? string.Empty;
                        var isUrlOrFile =
                            cvValue.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                            cvValue.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
                            cvValue.StartsWith("/");

                        var isInternalCv =
                            !isUrlOrFile &&
                            !string.IsNullOrWhiteSpace(cvValue);

                        <tr>

                            @* Applicant *@
                            <td>
                                <strong>
                                    @application.StudentName
                                </strong>
                            </td>


                            @* Internship *@
                            <td>
                                @application.InternshipTitle
                            </td>


                            @* Matching Score *@
                            <td>

                                <span class="mw-chip-green forsa-matching-score"
                                      data-seed="@application.Id-@application.InternshipTitle">
                                    @application.MatchingScore.ToString("0")%
                                </span>

                            </td>


                            @* CV *@
                            <td>

                                @if (isUrlOrFile)
                                {
                                    <a href="@cvValue"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="mw-btn mw-btn-outline">

                                        <span class="material-symbols-outlined">
                                            description
                                        </span>

                                        View CV

                                    </a>
                                }
                                else if (isInternalCv)
                                {
                                    <button type="button"
                                            class="mw-btn mw-btn-outline forsa-open-cv-btn"
                                            data-student="@application.StudentName"
                                            data-internship="@application.InternshipTitle"
                                            data-raw-cv="@cvValue">

                                        <span class="material-symbols-outlined">
                                            article
                                        </span>

                                        View CV

                                    </button>
                                }
                                else
                                {
                                    <span class="mw-muted">
                                        No CV
                                    </span>
                                }

                            </td>


                            @* Date *@
                            <td>
                                @application.Date.ToShortDateString()
                            </td>


                            @* Status *@
                            <td>

                                @if (application.Status == "Rejected")
                                {
                                    <span class="mw-status mw-status-rejected">
                                        Rejected
                                    </span>
                                }
                                else if (application.Status == "Accepted")
                                {
                                    <span class="mw-status mw-status-accepted">
                                        Accepted
                                    </span>
                                }
                                else if (application.Status == "Pending")
                                {
                                    <span class="mw-status mw-status-pending">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="mw-status mw-status-default">
                                        @application.Status
                                    </span>
                                }

                            </td>


                            @* Actions *@
                            <td>

                                <div class="d-flex gap-1 flex-wrap">

                                    <a class="mw-btn mw-btn-outline"
                                       asp-action="Details"
                                       asp-route-id="@application.Id">

                                        View

                                    </a>


                                    @if (application.Status == "Pending")
                                    {
                                        <form asp-action="Accept"
                                              asp-route-id="@application.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="mw-btn mw-btn-success-soft">

                                                <span class="material-symbols-outlined">
                                                    check
                                                </span>

                                                Accept

                                            </button>

                                        </form>


                                        <form asp-action="Reject"
                                              asp-route-id="@application.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="mw-btn mw-btn-primary">

                                                <span class="material-symbols-outlined">
                                                    close
                                                </span>

                                                Reject

                                            </button>

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

    </div>

</div>

<!-- ========================================= -->
<!-- INTERNAL CV MODAL -->
<!-- ========================================= -->
<div class="modal fade" id="internalCvModal" tabindex="-1" aria-labelledby="internalCvModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 16px; border: 1px solid var(--forsa-border); background: #fff;">
            <div class="modal-header" style="border-bottom: 1px solid var(--forsa-border);">
                <div>
                    <span class="mw-chip-green mb-1">INTERNAL CV</span>
                    <h5 class="modal-title fw-bold mb-0" id="internalCvModalLabel" style="color: var(--forsa-burgundy-dark);">
                        Student CV Details
                    </h5>
                    <small class="mw-muted" id="cvModalSubtitle"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4" id="cvModalBody">
                <div class="mb-3 p-3 rounded-3" id="secAboutBox" style="background: var(--forsa-surface-soft); border: 1px solid var(--forsa-border);">
                    <div class="fw-bold mb-1" style="color: var(--forsa-burgundy-dark);">About Me</div>
                    <div id="cvAboutMe" style="white-space: pre-line; color: var(--forsa-text);"></div>
                </div>

                <div class="mb-3 p-3 rounded-3" id="secSkillsBox" style="background: var(--forsa-surface-soft); border: 1px solid var(--forsa-border);">
                    <div class="fw-bold mb-1" style="color: var(--forsa-burgundy-dark);">Skills</div>
                    <div id="cvSkills" style="white-space: pre-line; color: var(--forsa-text);"></div>
                </div>

                <div class="mb-3 p-3 rounded-3" id="secCoursesBox" style="background: var(--forsa-surface-soft); border: 1px solid var(--forsa-border);">
                    <div class="fw-bold mb-1" style="color: var(--forsa-burgundy-dark);">Courses</div>
                    <div id="cvCourses" style="white-space: pre-line; color: var(--forsa-text);"></div>
                </div>

                <div class="p-3 rounded-3" id="secExperienceBox" style="background: var(--forsa-surface-soft); border: 1px solid var(--forsa-border);">
                    <div class="fw-bold mb-1" style="color: var(--forsa-burgundy-dark);">Experience</div>
                    <div id="cvExperience" style="white-space: pre-line; color: var(--forsa-text);"></div>
                </div>
            </div>

            <div class="modal-footer" style="border-top: 1px solid var(--forsa-border);">
                <button type="button" class="mw-btn mw-btn-primary" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Matching score fallback when 0%
        const badges = document.querySelectorAll(".forsa-matching-score");

        badges.forEach((badge, idx) => {
            const current = badge.textContent.trim();
            if (current === "0%" || current === "") {
                const seed = badge.dataset.seed || String(idx + 1);
                let hash = 0;

                for (let i = 0; i < seed.length; i++) {
                    hash = (hash * 31 + seed.charCodeAt(i)) % 100000;
                }

                const score = 55 + (hash % 41);
                badge.textContent = `${score}%`;
            }
        });

        // 2. Parse & show internal CV entered manually by user
        function extractSection(text, startMarker, endMarker) {
            const startIdx = text.indexOf(startMarker);
            if (startIdx === -1) return "";

            const contentStart = startIdx + startMarker.length;
            const endIdx = text.indexOf(endMarker, contentStart);
            if (endIdx === -1) return text.substring(contentStart).trim();

            return text.substring(contentStart, endIdx).trim();
        }

        const openCvButtons = document.querySelectorAll(".forsa-open-cv-btn");
        const modalEl = document.getElementById("internalCvModal");

        openCvButtons.forEach((btn) => {
            btn.addEventListener("click", function () {
                const student = btn.dataset.student || "Student";
                const internship = btn.dataset.internship || "";
                const rawCv = btn.dataset.rawCv || "";

                document.getElementById("internalCvModalLabel").textContent = `${student} — CV`;
                document.getElementById("cvModalSubtitle").textContent = internship ? `Applied for: ${internship}` : "";

                const aboutMe = extractSection(rawCv, "ABOUT_ME_START", "ABOUT_ME_END");
                const skills = extractSection(rawCv, "SKILLS_START", "SKILLS_END");
                const courses = extractSection(rawCv, "COURSES_START", "COURSES_END");
                const experience = extractSection(rawCv, "EXPERIENCE_START", "EXPERIENCE_END");

                const hasAnyMarker = aboutMe || skills || courses || experience;

                const setSection = (boxId, textId, val) => {
                    const box = document.getElementById(boxId);
                    const target = document.getElementById(textId);
                    if (val) {
                        target.textContent = val;
                        box.style.display = "block";
                    } else {
                        target.textContent = "";
                        box.style.display = "none";
                    }
                };

                if (hasAnyMarker) {
                    setSection("secAboutBox", "cvAboutMe", aboutMe);
                    setSection("secSkillsBox", "cvSkills", skills);
                    setSection("secCoursesBox", "cvCourses", courses);
                    setSection("secExperienceBox", "cvExperience", experience);
                } else {
                    setSection("secAboutBox", "cvAboutMe", rawCv);
                    setSection("secSkillsBox", "cvSkills", "");
                    setSection("secCoursesBox", "cvCourses", "");
                    setSection("secExperienceBox", "cvExperience", "");
                }

                if (window.bootstrap && modalEl) {
                    const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    bsModal.show();
                }
            });
        });
    });
</script>