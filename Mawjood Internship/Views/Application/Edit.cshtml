@using BLogicLayer.ViewModels
@model ApplicationViewModel

@{
    ViewData["Title"] = "Edit Application";
}

<section class="mw-section">
    <div class="mw-container">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="mw-card mw-form">

                    <span class="mw-eyebrow">UPDATE APPLICATION</span>
                    <h2 class="mb-4 fw-bold" style="color: var(--forsa-text);">
                        Edit Application
                    </h2>

                    <form asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="StudentId"
                                   class="form-label fw-semibold">
                                Student ID
                            </label>

                            <input asp-for="StudentId"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="InternshipId"
                                   class="form-label fw-semibold">
                                Internship ID
                            </label>

                            <input asp-for="InternshipId"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Date"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Date"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Status"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="Status"
                                    class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="Accepted">Accepted</option>
                                <option value="Rejected">Rejected</option>
                            </select>
                        </div>

                        <div class="d-flex gap-2 flex-wrap pt-2">
                            <button type="submit"
                                    class="mw-btn mw-btn-primary">
                                <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               class="mw-btn mw-btn-outline">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>
</section>