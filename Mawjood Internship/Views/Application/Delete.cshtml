@using BLogicLayer.ViewModels
@model ApplicationViewModel

@{
    ViewData["Title"] = "Delete Application";
}

<section class="mw-section">
    <div class="mw-container">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="mw-card mw-card-pad">

                    <div class="pb-3 mb-4" style="border-bottom: 1px solid var(--forsa-border);">
                        <span class="mw-eyebrow" style="color: var(--forsa-burgundy);">CONFIRM ACTION</span>
                        <h3 class="mb-0 fw-bold" style="color: var(--forsa-burgundy-dark);">
                            Delete Application
                        </h3>
                    </div>

                    <div class="mw-alert mw-alert-error mb-4" style="width: 100%; margin-top: 0;">
                        Are you sure you want to delete this application?
                    </div>

                    <div class="mw-info-grid mb-4">
                        <div class="mw-info-item">
                            <div class="mw-info-label">Student</div>
                            <div class="mw-info-value">@Model.StudentName</div>
                        </div>

                        <div class="mw-info-item">
                            <div class="mw-info-label">Internship</div>
                            <div class="mw-info-value">@Model.InternshipTitle</div>
                        </div>
                    </div>

                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit"
                                    class="mw-btn mw-btn-primary"
                                    style="background: var(--forsa-burgundy-dark);">
                                <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                                Yes, Delete
                            </button>

                            <a asp-action="Index"
                               class="mw-btn mw-btn-outline">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>
</section>