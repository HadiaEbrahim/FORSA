@model BLogicLayer.ViewModels.ApplicationViewModel

@{
    ViewData["Title"] = "Application Details";

    var statusClass = Model.Status?.ToLower() switch
    {
        "accepted" or "approved" => "mw-status mw-status-accepted",
        "rejected" => "mw-status mw-status-rejected",
        "pending" => "mw-status mw-status-pending",
        _ => "mw-status mw-status-default"
    };
}

<section class="mw-section">
    <div class="mw-container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="mw-card mw-card-pad">

                    <div class="pb-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2"
                         style="border-bottom: 1px solid var(--forsa-border);">
                        <div>
                            <span class="mw-eyebrow">APPLICATION SUMMARY</span>
                            <h2 class="mb-0 fw-bold" style="color: var(--forsa-text);">
                                Application Details
                            </h2>
                        </div>

                        <span class="@statusClass">
                            @Model.Status
                        </span>
                    </div>

                    <div class="mw-info-grid mb-4">
                        <div class="mw-info-item">
                            <div class="mw-info-label">Student</div>
                            <div class="mw-info-value">@Model.StudentName</div>
                        </div>

                        <div class="mw-info-item">
                            <div class="mw-info-label">Internship</div>
                            <div class="mw-info-value">@Model.InternshipTitle</div>
                        </div>

                        <div class="mw-info-item">
                            <div class="mw-info-label">Date</div>
                            <div class="mw-info-value">@Model.Date.ToShortDateString()</div>
                        </div>

                        <div class="mw-info-item">
                            <div class="mw-info-label">Status</div>
                            <div class="mw-info-value">@Model.Status</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap pt-2">
                        <a asp-action="Index"
                           class="mw-btn mw-btn-outline">
                            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
                            Back
                        </a>

                        @if (User.IsInRole("Admin") && Model.Status != "Rejected")
                        {
                            <form asp-action="Reject"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  style="display:inline">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="mw-btn mw-btn-primary"
                                        style="background: var(--forsa-burgundy-dark);">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">close</span>
                                    Reject
                                </button>
                            </form>
                        }
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>