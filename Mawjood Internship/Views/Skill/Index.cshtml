@model List<BLogicLayer.ViewModels.SkillViewModel>
@{
    ViewData["Title"] = "Skills";
}

<div class="mw-container mw-section">
    <div class="mw-section-head">
        <div>
            <div class="mw-chip">Admin</div>
            <h2 class="mt-2">Skills Management</h2>
            <p>Manage the skills available in the existing system.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a class="mw-btn mw-btn-primary" asp-action="Create">
                <span class="material-symbols-outlined">add</span> Add Skill
            </a>
        }
    </div>

    <div class="mw-card mw-card-pad">
        @if (Model == null || !Model.Any())
        {
            <div class="mw-empty">
                <span class="material-symbols-outlined" style="font-size: 42px;">psychology</span>
                <h3 class="mt-3">No skills found</h3>
                <p>There are currently no skills in the system.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var skill in Model)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="mw-card mw-card-pad h-100 d-flex flex-column justify-content-between gap-3">
                            <div>
                                <span class="mw-chip-green fw-semibold">
                                    @skill.Name
                                </span>
                            </div>

                            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                <a class="mw-btn mw-btn-primary"
                                   asp-action="Roadmap"
                                   asp-route-id="@skill.Id">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">route</span>
                                    Roadmap
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="d-flex gap-1">
                                        <a class="mw-btn mw-btn-outline"
                                           asp-action="Edit"
                                           asp-route-id="@skill.Id">
                                            Edit
                                        </a>
                                        <a class="mw-btn mw-btn-outline"
                                           asp-action="Delete"
                                           asp-route-id="@skill.Id">
                                            Delete
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>