@model BLogicLayer.ViewModels.SkillViewModel

@{
    ViewData["Title"] = "Skill Details";
}

<section class="mw-section">
    <div class="mw-container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="mw-card mw-card-pad">

                    <div class="pb-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2"
                         style="border-bottom: 1px solid var(--forsa-border);">
                        <div>
                            <span class="mw-eyebrow">SKILL SUMMARY</span>
                            <h2 class="mb-0 fw-bold" style="color: var(--forsa-text);">
                                Skill Details
                            </h2>
                        </div>

                        <span class="mw-chip-green">Active Skill</span>
                    </div>

                    <div class="mw-info-item mb-4">
                        <div class="mw-info-label">Skill Name</div>
                        <div class="mw-info-value fs-5">@Model.Name</div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap pt-2">
                        <a asp-action="Roadmap"
                           asp-route-id="@Model.Id"
                           class="mw-btn mw-btn-primary">
                            <span class="material-symbols-outlined" style="font-size: 18px;">route</span>
                            View Roadmap
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="mw-btn mw-btn-outline">
                                <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>
                                Edit
                            </a>
                        }

                        <a asp-action="Index"
                           class="mw-btn mw-btn-outline">
                            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
                            Back
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>