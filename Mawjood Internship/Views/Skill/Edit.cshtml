@model BLogicLayer.ViewModels.SkillViewModel

@{
    ViewData["Title"] = "Edit Skill";
}

<section class="mw-section">
    <div class="mw-container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">

                <div class="mw-card mw-form">

                    <span class="mw-eyebrow">SKILLS MANAGEMENT</span>
                    <h2 class="mb-4 fw-bold" style="color: var(--forsa-text);">
                        Edit Skill
                    </h2>

                    <form asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="mw-alert mw-alert-error mb-3"
                             style="width: 100%; margin-top: 0;">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control mw-input" />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="d-flex gap-2 flex-wrap pt-2">
                            <button type="submit"
                                    class="mw-btn mw-btn-primary">
                                <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               class="mw-btn mw-btn-outline">
                                Back
                            </a>
                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}