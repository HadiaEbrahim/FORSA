@model BLogicLayer.ViewModels.CVViewModel
@{
    ViewData["Title"] = "My CV";
}

<div class="mw-container mw-section">
    <div class="mw-section-head">
        <div>
            <div class="mw-chip-green">Student Portal</div>
            <h2 class="mt-2" style="color: var(--forsa-text);">My Curriculum Vitae (CV)</h2>
            <p class="mw-muted mb-0">Manage your PDF CV, external portfolio link, and internal CV details.</p>
        </div>
        <a class="mw-btn mw-btn-primary" asp-action="Create">
            <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>
            Edit CV
        </a>
    </div>

    <div class="mw-card mw-card-pad" style="border-top: 3px solid var(--forsa-burgundy);">
        <h3 class="h5 fw-bold" style="color: var(--forsa-burgundy-dark);">CV / Portfolio</h3>

        @if (!string.IsNullOrWhiteSpace(Model.CVFilePath))
        {
            <div class="mw-info-item mt-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <div class="mw-info-label">Uploaded PDF</div>
                        <div class="mw-info-value">@System.IO.Path.GetFileName(Model.CVFilePath)</div>
                    </div>
                    <span class="mw-chip-green">Ready</span>
                </div>
                <div class="mw-actions-row">
                    <a class="mw-btn mw-btn-primary" href="@Model.CVFilePath" target="_blank" rel="noopener">View PDF</a>
                    <a class="mw-btn mw-btn-outline" href="@Model.CVFilePath" download>Download</a>
                </div>
            </div>
        }
        else
        {
            <div class="mw-empty mt-3" style="padding:28px 12px;">
                <span class="material-symbols-outlined" style="font-size:38px; color: var(--forsa-green-accent);">description</span>
                <p class="mt-2 mb-0 mw-muted">No uploaded PDF CV yet.</p>
            </div>
        }

        <div class="mw-info-item mt-3">
            <div class="mw-info-label">External CV / Portfolio Link</div>
            @if (!string.IsNullOrWhiteSpace(Model.ExternalCVLink))
            {
                <a class="mw-link" href="@Model.ExternalCVLink" target="_blank" rel="noopener">@Model.ExternalCVLink</a>
            }
            else
            {
                <div class="mw-info-value">—</div>
            }
        </div>
    </div>

    <div class="mw-card mw-card-pad mt-3">
        <h3 class="h5 fw-bold mb-3" style="color: var(--forsa-burgundy-dark);">CV Information</h3>
        <div class="mw-info-grid">
            <div class="mw-info-item"><div class="mw-info-label">Name</div><div class="mw-info-value">@Model.FName @Model.LName</div></div>
            <div class="mw-info-item"><div class="mw-info-label">Email</div><div class="mw-info-value">@Model.Email</div></div>
            <div class="mw-info-item"><div class="mw-info-label">University</div><div class="mw-info-value">@(Model.University ?? "—")</div></div>
            <div class="mw-info-item"><div class="mw-info-label">Major</div><div class="mw-info-value">@(Model.Major ?? "—")</div></div>
            <div class="mw-info-item"><div class="mw-info-label">Education</div><div class="mw-info-value">@(Model.Education ?? "—")</div></div>
            <div class="mw-info-item"><div class="mw-info-label">Academic Year</div><div class="mw-info-value">@(Model.AcademicYear?.ToString() ?? "—")</div></div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.AboutMe) ||
         !string.IsNullOrWhiteSpace(Model.Skills) ||
         !string.IsNullOrWhiteSpace(Model.Courses) ||
         !string.IsNullOrWhiteSpace(Model.Experience))
    {
        <div class="mw-card mw-card-pad mt-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <h3 class="h5 fw-bold mb-0" style="color: var(--forsa-burgundy-dark);">Additional CV Details</h3>
                <span class="mw-chip-green">Saved</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.AboutMe))
            {
                <div class="mw-detail-section" style="padding-top: 12px;">
                    <h4 class="h6 fw-bold" style="color: var(--forsa-burgundy-dark);">About Me</h4>
                    <p class="mw-muted mb-0" style="white-space: pre-line;">@Model.AboutMe</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Skills))
            {
                <div class="mw-detail-section">
                    <h4 class="h6 fw-bold" style="color: var(--forsa-burgundy-dark);">Skills</h4>
                    <p class="mw-muted mb-0" style="white-space: pre-line;">@Model.Skills</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Courses))
            {
                <div class="mw-detail-section">
                    <h4 class="h6 fw-bold" style="color: var(--forsa-burgundy-dark);">Courses & Certificates</h4>
                    <p class="mw-muted mb-0" style="white-space: pre-line;">@Model.Courses</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Experience))
            {
                <div class="mw-detail-section" style="padding-bottom: 0;">
                    <h4 class="h6 fw-bold" style="color: var(--forsa-burgundy-dark);">Experience</h4>
                    <p class="mw-muted mb-0" style="white-space: pre-line;">@Model.Experience</p>
                </div>
            }
        </div>
    }
</div>