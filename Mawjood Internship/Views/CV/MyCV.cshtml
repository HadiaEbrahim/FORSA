@model BLogicLayer.ViewModels.CVViewModel

@{
    ViewData["Title"] = "My CV";
}

<section class="mw-section">
    <div class="mw-container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="mw-card mw-card-pad" style="padding: 36px;">

                    <!-- ========================= -->
                    <!-- HEADER -->
                    <!-- ========================= -->
                    <div class="text-center mb-5 pb-4" style="border-bottom: 1px solid var(--forsa-border);">
                        <div class="mw-avatar mx-auto mb-3">
                            @(string.IsNullOrWhiteSpace(Model.FName) ? "F" : Model.FName.Substring(0, 1).ToUpper())
                        </div>

                        <h1 class="fw-bold mb-1" style="color: var(--forsa-text);">
                            @Model.FName @Model.LName
                        </h1>

                        <p class="mw-muted mb-1">
                            @Model.Email
                        </p>

                        @if (!string.IsNullOrWhiteSpace(Model.Major))
                        {
                            <span class="mw-chip mt-2">
                                @Model.Major
                            </span>
                        }
                    </div>

                    <!-- ========================= -->
                    <!-- PERSONAL INFORMATION -->
                    <!-- ========================= -->
                    <h4 class="pb-2 mb-4" style="color: var(--forsa-burgundy-dark); border-bottom: 1px solid var(--forsa-border); font-weight: 700;">
                        Personal Information
                    </h4>

                    <div class="mw-info-grid mb-4">
                        <div class="mw-info-item">
                            <div class="mw-info-label">First Name</div>
                            <div class="mw-info-value">@Model.FName</div>
                        </div>

                        <div class="mw-info-item">
                            <div class="mw-info-label">Last Name</div>
                            <div class="mw-info-value">@Model.LName</div>
                        </div>

                        <div class="mw-info-item" style="grid-column: 1 / -1;">
                            <div class="mw-info-label">Email</div>
                            <div class="mw-info-value">@Model.Email</div>
                        </div>
                    </div>

                    <!-- ========================= -->
                    <!-- EDUCATION -->
                    <!-- ========================= -->
                    <h4 class="pb-2 mb-4 mt-4" style="color: var(--forsa-burgundy-dark); border-bottom: 1px solid var(--forsa-border); font-weight: 700;">
                        Education
                    </h4>

                    <div class="mw-info-grid mb-4">
                        <div class="mw-info-item">
                            <div class="mw-info-label">University</div>
                            <div class="mw-info-value">@Model.University</div>
                        </div>

                        <div class="mw-info-item">
                            <div class="mw-info-label">Major</div>
                            <div class="mw-info-value">@Model.Major</div>
                        </div>

                        <div class="mw-info-item">
                            <div class="mw-info-label">Academic Year</div>
                            <div class="mw-info-value">@Model.AcademicYear</div>
                        </div>

                        <div class="mw-info-item">
                            <div class="mw-info-label">Education</div>
                            <div class="mw-info-value">@Model.Education</div>
                        </div>
                    </div>

                    <!-- ========================= -->
                    <!-- LOCATION -->
                    <!-- ========================= -->
                    <h4 class="pb-2 mb-4 mt-4" style="color: var(--forsa-burgundy-dark); border-bottom: 1px solid var(--forsa-border); font-weight: 700;">
                        Location
                    </h4>

                    <div class="mw-info-grid mb-4">
                        <div class="mw-info-item">
                            <div class="mw-info-label">City</div>
                            <div class="mw-info-value">@Model.City</div>
                        </div>

                        <div class="mw-info-item">
                            <div class="mw-info-label">Government</div>
                            <div class="mw-info-value">@Model.Government</div>
                        </div>
                    </div>

                    <!-- ========================= -->
                    <!-- ABOUT ME -->
                    <!-- ========================= -->
                    @if (!string.IsNullOrWhiteSpace(Model.AboutMe))
                    {
                        <div class="mw-detail-section">
                            <h2 style="color: var(--forsa-burgundy-dark);">About Me</h2>
                            <p class="mw-muted mb-0" style="white-space: pre-line; line-height: 1.7;">
                                @Model.AboutMe
                            </p>
                        </div>
                    }

                    <!-- ========================= -->
                    <!-- SKILLS -->
                    <!-- ========================= -->
                    @if (!string.IsNullOrWhiteSpace(Model.Skills))
                    {
                        <div class="mw-detail-section">
                            <h2 style="color: var(--forsa-burgundy-dark);">Skills</h2>
                            <p class="mw-muted mb-0" style="white-space: pre-line; line-height: 1.7;">
                                @Model.Skills
                            </p>
                        </div>
                    }

                    <!-- ========================= -->
                    <!-- COURSES -->
                    <!-- ========================= -->
                    @if (!string.IsNullOrWhiteSpace(Model.Courses))
                    {
                        <div class="mw-detail-section">
                            <h2 style="color: var(--forsa-burgundy-dark);">Courses & Certificates</h2>
                            <p class="mw-muted mb-0" style="white-space: pre-line; line-height: 1.7;">
                                @Model.Courses
                            </p>
                        </div>
                    }

                    <!-- ========================= -->
                    <!-- EXPERIENCE -->
                    <!-- ========================= -->
                    @if (!string.IsNullOrWhiteSpace(Model.Experience))
                    {
                        <div class="mw-detail-section">
                            <h2 style="color: var(--forsa-burgundy-dark);">Experience</h2>
                            <p class="mw-muted mb-0" style="white-space: pre-line; line-height: 1.7;">
                                @Model.Experience
                            </p>
                        </div>
                    }

                    <!-- ========================= -->
                    <!-- EXTERNAL CV & EDIT -->
                    <!-- ========================= -->
                    <div class="mt-5 d-grid gap-3">
                        @if (!string.IsNullOrWhiteSpace(Model.ExistingCVLink))
                        {
                            <a href="@Model.ExistingCVLink"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="mw-btn mw-btn-success-soft w-100 mw-btn-lg">
                                Open My CV Link
                            </a>
                        }

                        <a asp-action="Create"
                           class="mw-btn mw-btn-primary w-100 mw-btn-lg">
                            Edit My CV
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>